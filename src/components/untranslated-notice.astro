---
import { IconLanguage } from '@tabler/icons-react'
---

{
	Astro.locals.starlightRoute.isFallback && (
		<p data-untranslated-notice class="spica-surface not-content mt-0 mb-4 flex items-center gap-2 rounded-2xl border border-primary-line bg-primary-soft px-4 py-2.5 font-sans text-sm leading-[1.55] text-pretty text-ink-soft">
			<IconLanguage
				size={17}
				stroke={1.5}
				aria-hidden="true"
				className="shrink-0 text-primary-deep"
			/>
			{Astro.locals.t('i18n.untranslatedContent')}
		</p>
	)
}
