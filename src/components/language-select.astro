---
import { getEntry } from 'astro:content'

import { Select } from './ui/select'
import { defaultLocale, flags, locales, stripLocale } from '../lib/locales.mjs'

const route = Astro.locals.starlightRoute
const pathname = stripLocale(Astro.url.pathname)
const current = (route.locale ?? defaultLocale) as keyof typeof locales
// pages outside the docs collection (the /i18n/ dashboard) have no localized copies to switch to
const translatable = await getEntry('docs', `${defaultLocale}/${stripLocale(route.id)}`.replace(/\/$/, ''))
---

{
	translatable && (
		<spica-language-select class="relative block">
			<span
				aria-hidden="true"
				class="pointer-events-none absolute top-1/2 left-3 z-1 -translate-y-1/2 overflow-hidden rounded-[3px] leading-none shadow-[0_0_0_1px_var(--color-border)]"
			>
				{current === 'th' ? (
					<svg width="20" height="14" viewBox="0 0 30 21" class="block">
						<rect width="30" height="21" fill="#A51931" />
						<rect y="3.5" width="30" height="14" fill="#F4F5F8" />
						<rect y="7" width="30" height="7" fill="#2D2A4A" />
					</svg>
				) : (
					<svg width="20" height="14" viewBox="0 0 60 42" class="block">
						<rect width="60" height="42" fill="#012169" />
						<path d="M0,0 L60,42 M60,0 L0,42" stroke="#FFF" stroke-width="8" />
						<path d="M0,0 L60,42 M60,0 L0,42" stroke="#C8102E" stroke-width="3" />
						<path d="M30,0 V42 M0,21 H60" stroke="#FFF" stroke-width="12" />
						<path d="M30,0 V42 M0,21 H60" stroke="#C8102E" stroke-width="7" />
					</svg>
				)}
			</span>
			<Select
				variant="ghost"
				aria-label="Language"
				className="pl-11"
				options={Object.entries(locales).map(([locale, { label }]) => ({
					value: `/${locale}${pathname}`,
					label: `${flags[locale as keyof typeof flags]} ${label}`
				}))}
				value={`/${current}${pathname}`}
			/>
		</spica-language-select>
	)
}

<script>
	customElements.define(
		'spica-language-select',
		class extends HTMLElement {
			connectedCallback() {
				const select = this.querySelector('select')!
				select.onchange = () => (location.pathname = select.value)
				// a back-forward cache restore keeps the language picked before leaving
				addEventListener('pageshow', () => {
					select.value =
						select.querySelector<HTMLOptionElement>('option[selected]')
							?.value ?? select.value
				})
			}
		}
	)
</script>
