---
interface Props {
	items: {
		label: string
		detail?: string
		value: number
		display?: string
		secondaryValue?: number
		secondaryDisplay?: string
		highlight?: boolean
	}[]
	unit?: string
	secondaryUnit?: string
	series?: [string, string]
}

const { items, unit, secondaryUnit, series } = Astro.props

const maximum =
	Math.max(
		...items.flatMap(({ value, secondaryValue }) =>
			secondaryUnit ? [value] : [value, secondaryValue ?? 0]
		)
	) || 1

const secondaryMaximum = secondaryUnit
	? Math.max(...items.map(({ secondaryValue }) => secondaryValue ?? 0)) || 1
	: maximum
---

{
	series && (
		<div class="mt-4 mb-6 flex justify-end gap-4 text-xs text-ink-muted">
			<span class="flex items-center gap-1.5">
				<i class="size-2 rounded-full bg-border" />
				{series[0]}
			</span>
			<span class="flex items-center gap-1.5">
				<i class="size-2 rounded-full bg-harmony-center-soft outline-1 -outline-offset-1 outline-harmony-center-line" />
				{series[1]}
			</span>
		</div>
	)
}

<ol class="chart my-6 flex list-none flex-col gap-4 p-0">
	{
		items.map((item) => (
			<li class="m-0 grid grid-cols-[minmax(7.5rem,10rem)_minmax(4rem,1fr)_max-content] items-center gap-2.5">
				<span
					class={`text-sm font-semibold text-ink-soft ${item.highlight ? 'text-primary-deep' : ''}`}
				>
					{item.label}
					{item.detail && (
						<sup class="ml-1 text-[0.65rem] font-normal text-ink-muted">
							{item.detail}
						</sup>
					)}
				</span>
				<div class="flex flex-col gap-1">
					<div class="h-3.5">
						<div
							class={`h-full rounded-full ${item.highlight ? 'bg-primary' : 'bg-border'}`}
							style={`width: ${(item.value / maximum) * 100}%`}
						/>
					</div>
					{item.secondaryValue !== undefined && (
						<div class="h-3.5">
							<div
								class={`h-full rounded-full outline-1 -outline-offset-1 outline-harmony-center-line ${item.highlight ? 'bg-harmony-center' : 'bg-harmony-center-soft'}`}
								style={`width: ${(item.secondaryValue / secondaryMaximum) * 100}%`}
							/>
						</div>
					)}
				</div>
				<div class="flex flex-col gap-1">
					<strong class="ml-auto flex h-3.5 items-center text-right text-xs font-medium tabular-nums text-ink-muted">
						{item.display ?? `${item.value.toLocaleString('en-US')} ${unit ?? ''}`}
					</strong>
					{item.secondaryValue !== undefined && (
						<strong class="ml-auto flex h-3.5 items-center text-right text-xs font-medium tabular-nums text-ink-muted">
							{item.secondaryDisplay ??
								`${item.secondaryValue.toLocaleString('en-US')} ${secondaryUnit ?? unit ?? ''}`}
						</strong>
					)}
				</div>
			</li>
		))
	}
</ol>
