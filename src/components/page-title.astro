---
import StarlightPageTitle from '@astrojs/starlight/components/PageTitle.astro'
import Breadcrumb from './breadcrumb'
import UntranslatedNotice from './untranslated-notice.astro'

const { entry, sidebar, hasSidebar, locale } = Astro.locals.starlightRoute
const hasInlineTitle = entry.data.template === 'splash'
---

<UntranslatedNotice />

{
	!hasInlineTitle && (
		<>
			{hasSidebar && (
				<Breadcrumb
					client:load
					sidebar={sidebar}
					title={entry.data.title}
					root={{ label: 'Docs', href: `/${locale ?? 'en'}/table-of-content/` }}
				/>
			)}
			<StarlightPageTitle />
		</>
	)
}

<style is:global>
	@layer starlight.core {
		/* the interactive layout renders its own breadcrumb and untranslated notice */
		main:has([data-interactive-doc-layout])
			> :is(
				.content-panel:has(> .sl-container:empty),
				.content-panel:has(> .sl-container > [data-untranslated-notice]:only-child)
			) {
			display: none;
		}

		main:has([data-interactive-doc-layout])
			> :is(
				.content-panel:has(> .sl-container:empty),
				.content-panel:has(> .sl-container > [data-untranslated-notice]:only-child)
			)
			+ .content-panel {
			border-top: 0;
		}
	}
</style>
