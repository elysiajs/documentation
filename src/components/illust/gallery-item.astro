---
import type { GalleryItem } from './gallery'

interface Props extends GalleryItem {
	id: string
	comic?: boolean
}

const { id, comic = false, description, cover, illust, page } = Astro.props
const first = page[0]
---

<article class:list={['gallery-item', { 'gallery-item-comic': comic }]}>
	<button
		type="button"
		class="gallery-cover"
		data-open-dialog={id}
		aria-haspopup="dialog"
		aria-controls={id}
		aria-label={`View ${description}`}
	>
		<img src={cover} alt={description} loading="lazy" decoding="async" />
		<span class="gallery-cover-hint" aria-hidden="true">View {comic ? 'comic' : 'illustration'} ↗</span>
	</button>

	<h3>{description}</h3>
	<p class="gallery-credit">Illustration by {illust}</p>

	<dialog id={id} class="illust-dialog gallery-dialog" aria-labelledby={`${id}-title`} aria-describedby={`${id}-credit`} closedby="closerequest">
		<div class="gallery-image" data-gallery-image>
			<template data-dialog-image><img data-src={first.src} alt={first.title} decoding="async" loading="eager" /></template>
		</div>
		<section class="gallery-controls">
			<header>
				<h2 id={`${id}-title`} data-gallery-title>{first.title}</h2>
				<button type="button" class="dialog-close" data-close-dialog aria-label="Close gallery" autofocus>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
				</button>
			</header>

			<p id={`${id}-credit`} class="gallery-credit">Illustration by {illust}</p>

			<div class="gallery-variants" role="group" aria-label={comic ? 'Comic language' : 'Illustration variant'}>
				{page.map((item, index) => (
					<button type="button" data-gallery-src={item.src} data-gallery-title={item.title} aria-pressed={index === 0} aria-label={`${comic ? 'Read' : 'View'} ${item.lang}`}>
						{item.lang}
					</button>
				))}
			</div>
		</section>
	</dialog>
</article>
