---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import Blog from '../../layouts/blog.astro'
import Outline from '../../components/blog/outline.astro'
import avatar from '../../assets/blog/authors/ely.webp'
import Footer from '../../components/footer.astro'

export async function getStaticPaths() {
	const posts = await getCollection('blog')
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const { title, description, date, cover, alt, author, shadow, kind } = post.data
const outlineHeadings = headings.filter(
	({ depth }) => depth === 2 || depth === 3
)

const kindLabel = {
	release: 'Release',
	guide: 'Guide',
	benchmark: 'Benchmark',
	announcement: 'Announcement'
}

// Unquoted YAML dates are UTC midnight, so the label is formatted in UTC too.
const formatted = date.toLocaleDateString('en-GB', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
	timeZone: 'UTC'
})
const iso = date.toISOString().slice(0, 10)
const ogImage = new URL(
	cover.src,
	import.meta.env.PROD ? Astro.site : Astro.url
).href
const transitionCoverId = 'blog-transition-cover'
---

<Blog
	title={title}
	description={description}
	image={ogImage}
	imageAlt={alt}
	transitionCoverId={transitionCoverId}
>
	<div data-blog-article class="mx-auto max-w-[44rem] px-6 pt-10 pb-20">
		<Outline headings={outlineHeadings} />
		<a
			href="/blog/"
			class="blog-link rounded-lg text-sm text-ink-muted no-underline focus-ring"
			>← Blog</a
		>
		<p class="mt-6 flex flex-wrap items-center gap-2 text-sm font-semibold">
			<span class="text-ink-soft">{kindLabel[kind]}</span>
			<span aria-hidden="true" class="text-ink-muted">·</span>
			<time datetime={iso} class="text-ink-muted">{formatted}</time>
		</p>
		<h1
			class="mt-3 font-display font-normal text-[clamp(2rem,4.5vw,3rem)] leading-[1.08] text-balance"
		>
			{title}
		</h1>
		<div class="mt-5 flex items-center gap-3">
			<Image
				src={avatar}
				alt=""
				width={72}
				height={72}
				loading="lazy"
				class="size-9 rounded-full"
			/>
			<div>
				<p class="font-semibold">{author}</p>
				<p class="text-sm text-ink-muted">
					<a
						href="https://twitter.com/saltyaom"
						class="blog-link rounded-lg text-ink-muted no-underline focus-ring"
						>@saltyaom</a
					>
				</p>
			</div>
		</div>
		<div class="relative mt-8 bg-surface rounded-2xl">
			<Image
				data-blog-cover
				id={transitionCoverId}
				src={cover}
				alt={alt}
				layout="constrained"
				width={1408}
				priority
				class:list={[
					'relative w-full rounded-2xl object-cover z-20',
					shadow ? '' : 'border border-border'
				]}
			/>
			{
				shadow && (
					<Image
						src={cover}
						alt="hidden"
						width={64}
						loading="lazy"
						aria-hidden="true"
						class="absolute inset-0 z-10 size-full blur-2xl opacity-90 object-cover"
					/>
				)
			}
		</div>
		<article class="sl-markdown-content mt-10">
			<Content />
		</article>
		<nav class="mt-16 border-t border-border pt-6" aria-label="Blog">
			<a
				href="/blog/"
				class="blog-link rounded-lg text-ink-muted no-underline focus-ring"
				>← All posts</a
			>
		</nav>
	</div>
</Blog>

<Footer />
