{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "bun"],
		"jsx": "react-jsx",
		"strict": true,
		"allowJs": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src", "vite.config.ts"]
}
